    <path
        android:pathData="M41,32 L62,32 L68,38 L68,76 L41,76 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.8"
        android:strokeLineJoin="round"
        android:strokeLineCap="round" />

    <!-- 折角 -->
    <path
        android:pathData="M62,32 L62,38 L68,38"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.8"
        android:strokeLineJoin="round"
        android:strokeLineCap="round" />

    <!-- 文字线 -->
    <path
        android:pathData="M46,46 L63,46"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.8"
        android:strokeLineCap="round" />
    <path
        android:pathData="M46,55 L63,55"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.8"
        android:strokeLineCap="round" />
    <path
        android:pathData="M46,64 L56,64"
